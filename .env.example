# =====================================================================
#  Ledgerly - central configuration
#  Copy this file to ".env" and change the values for your machine.
#  The backend (FastAPI) and docker-compose (PostgreSQL) both read it.
#  The frontend has its own file: frontend/.env.local
# =====================================================================

# ---------- Application ----------
APP_NAME=Ledgerly
APP_ENV=development
API_PREFIX=/api/v1
DEBUG=false

# ---------- Database (PostgreSQL) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ledgerly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ledgerly
# Used only by the automated tests - it is wiped on every test run
TEST_POSTGRES_DB=ledgerly_test
DATABASE_ECHO=false

# ---------- Security ----------
# Generate a new one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
BCRYPT_ROUNDS=12

# ---------- CORS (which frontend URLs may call the API) ----------
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Business defaults ----------
DEFAULT_CURRENCY=USD
DEFAULT_PAYMENT_TERMS_DAYS=30
INVOICE_NUMBER_START=1001
