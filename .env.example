# =====================================================================
#  DigiBooks - central configuration
#  Copy this file to ".env" and change the values for your machine.
#  The backend (FastAPI) and docker-compose (PostgreSQL) both read it.
#  The frontend has its own file: frontend/.env.local
# =====================================================================

# ---------- Application ----------
APP_NAME=DigiBooks
APP_ENV=development
API_PREFIX=/api/v1
DEBUG=false

# ---------- Database (PostgreSQL) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ledgerly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ledgerly
# Python database driver: psycopg (default, fastest) or pg8000 (pure Python -
# use it if Windows Application Control blocks compiled files)
POSTGRES_DRIVER=psycopg
# Used only by the automated tests - it is wiped on every test run
TEST_POSTGRES_DB=ledgerly_test
DATABASE_ECHO=false

# ---------- Security ----------
# Generate a new one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
BCRYPT_ROUNDS=12

# ---------- CORS (which frontend URLs may call the API) ----------
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Business defaults ----------
DEFAULT_CURRENCY=USD
DEFAULT_PAYMENT_TERMS_DAYS=30
INVOICE_NUMBER_START=1001
MAX_LOGO_BYTES=500000
MAX_ATTACHMENT_BYTES=5000000
# Vendors paid at least this much in a year get a 1099
FORM_1099_THRESHOLD=600
FIRST_CHECK_NUMBER=1001

# ---------- Links sent to customers ----------
# Address of the frontend that customers open (invoice "view and pay" links)
PUBLIC_APP_URL=http://localhost:3000

# ---------- Email (EXT) ----------
# log  = don't send, only record emails in the app's Email log (no setup needed)
# smtp = really send, using the SMTP settings below
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---------- Online invoice payments (EXT) ----------
# none = "Pay now" is hidden on the customer view. Add a provider class to enable.
PAYMENT_PROVIDER=none
PAYMENT_PROVIDER_SECRET_KEY=

# ---------- Bank feeds (EXT) ----------
# none = no live feed; upload CSV / OFX / QFX statements instead
BANK_FEED_PROVIDER=none
BANK_FEED_CLIENT_ID=
BANK_FEED_SECRET=
# Days apart a bank line and a book transaction can be to be suggested as a match
BANK_MATCH_DAYS=14

# ---------- Sales tax rates / e-filing (EXT) ----------
# none = enter sales tax rates by hand
TAX_RATE_PROVIDER=none
TAX_RATE_API_KEY=

# ---------- Payroll ----------
# Overtime pay = hourly rate x this
PAYROLL_OVERTIME_MULTIPLIER=1.5
# (EXT) none = payroll taxes are pay items you set up; direct deposit is sent by you
PAYROLL_PROVIDER=none
PAYROLL_PROVIDER_API_KEY=

# ---------- Exchange rates (EXT) ----------
# none = type exchange rates in on Settings -> Currencies
EXCHANGE_RATE_PROVIDER=none
EXCHANGE_RATE_API_KEY=

# ---------- Webhooks (EXT) ----------
# log = record what would be sent (nothing leaves the app); http = POST to each webhook URL
WEBHOOK_DELIVERY=log
WEBHOOK_TIMEOUT_SECONDS=5

# ---------- Docker (docker compose up -d --build) ----------
# Ports on your machine for the API and the web app
BACKEND_PORT=8000
FRONTEND_PORT=3000
# The API address the browser uses - written into the web app when it is built,
# so rebuild the frontend after changing it (docker compose build frontend)
PUBLIC_API_URL=http://localhost:8000/api/v1
APP_LOCALE=en-US
# API server processes
API_WORKERS=2
# How often the scheduler runs the daily job (seconds; 86400 = once a day)
DAILY_JOBS_INTERVAL_SECONDS=86400
SCHEDULER_START_DELAY_SECONDS=30

# ---------- Time zone ----------
# The business's time zone: decides what "today" is for due dates, reports and the
# daily job when running in Docker (e.g. America/New_York, Europe/London, Asia/Kolkata)
TZ=UTC
